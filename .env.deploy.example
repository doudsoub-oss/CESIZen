# Variables attendues par la composition de déploiement (compose.prod.yml /
# compose.recette.yml). À copier en `.env` SUR LE SERVEUR, jamais versionné.
# Aucune valeur sensible ne figure ici : ce fichier ne documente que les clés.

# ── Application ────────────────────────────────────────────────────────────
APP_NAME=CESIZen
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# ── Base de données (aucun port publié en déploiement) ─────────────────────
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ── Sessions / cache / files (tout sur PostgreSQL, aucune infra en mémoire) ─
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# ── Messagerie SMTP RÉELLE (remplace mailpit) ──────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# ── Image (registre) : l'app n'est jamais construite sur le serveur ────────
IMAGE_REGISTRY=ghcr.io/doudsoub-oss/cesizen
IMAGE_TAG=latest

# ── Proxy d'entrée (Traefik) ───────────────────────────────────────────────
# Domaine servi et adresse de contact Let's Encrypt.
APP_DOMAIN=
ACME_EMAIL=

# ── Sauvegardes chiffrées (L18, engagement 2.8) ────────────────────────────
# Phrase secrète du chiffrement AES-256 des sauvegardes. OBLIGATOIRE. Ne jamais
# la versionner ; sa rotation est décrite dans rotation-des-secrets.md (garder
# l'ancienne le temps de la rétention, sinon les sauvegardes deviennent illisibles).
BACKUP_PASSPHRASE=
BACKUP_RETENTION_DAYS=30
# Externalisation 3-2-1 : false en RECETTE (local uniquement), true en PRODUCTION.
BACKUP_REMOTE_ENABLED=false
# En production : nom du remote rclone et chemin cible du stockage objet. Les
# identifiants du stockage objet sont configurés dans rclone SUR L'INSTANCE
# (RCLONE_CONFIG_* ou rclone.conf hors dépôt) — la clé ne quitte jamais le serveur.
BACKUP_REMOTE=
BACKUP_REMOTE_PATH=
# Commande d'alerte exécutée après deux échecs consécutifs (raccordée au L20).
BACKUP_ALERT_COMMAND=

# ── Recette uniquement (compose.recette.yml) ───────────────────────────────
# Paire(s) htpasswd bcrypt « user:$2y$... ». Générer avec :
#   htpasswd -nbB recetteur 'motdepasse'
# Attention : doubler les « $ » (…$$2y$$…) car docker compose interpole « $ ».
RECETTE_BASICAUTH=
