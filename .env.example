# =============================================================================
# CESIZen — modèle de configuration d'environnement
# -----------------------------------------------------------------------------
# Copiez ce fichier en `.env` puis renseignez les valeurs. AUCUNE valeur réelle
# de secret ne doit être écrite ici : ce fichier est versionné. Les secrets
# (APP_KEY, mots de passe, identifiants) sont injectés à l'exécution et
# documentés, sans valeur, ci-dessous. Procédure de rotation :
# docs/exploitation/rotation-des-secrets.md.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_NAME=CESIZen
APP_ENV=local                       # local | recette | production
APP_KEY=                            # SECRET — généré par `php artisan key:generate`, jamais commité
APP_DEBUG=true                      # true en local uniquement ; false hors développement
APP_URL=http://localhost            # URL de base publique de l'application
# APP_PREVIOUS_KEYS=                 # SECRET — anciennes APP_KEY, le temps d'un rechiffrement (voir L05)

# --- Localisation ------------------------------------------------------------
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

# --- Maintenance -------------------------------------------------------------
APP_MAINTENANCE_DRIVER=file         # file | cache
# APP_MAINTENANCE_STORE=database     # magasin si APP_MAINTENANCE_DRIVER=cache

# --- Sécurité du hachage -----------------------------------------------------
BCRYPT_ROUNDS=12                    # coût bcrypt des mots de passe

# --- Journalisation ----------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug                     # debug en local ; warning/error conseillé hors développement

# --- Base de données (PostgreSQL 16) -----------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=cesizen
DB_USERNAME=cesizen
DB_PASSWORD=                        # SECRET — mot de passe PostgreSQL, injecté à l'exécution
# DB_URL=                            # SECRET — alternative : URL de connexion complète (contient l'identifiant)
# DB_SSLMODE=require                 # require/verify-full hors développement (transport chiffré vers la base)

# --- Sessions (pilote base de données — pas de magasin en mémoire) -----------
SESSION_DRIVER=database             # base de données : conforme au §3.1 (aucun Redis/Memcached)
SESSION_LIFETIME=120                # durée de vie en minutes
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_CONNECTION=                # connexion DB dédiée aux sessions (défaut : connexion principale)
# SESSION_TABLE=sessions
SESSION_SECURE_COOKIE=false         # true hors local — cookie transmis en HTTPS uniquement (activé au L04)
SESSION_SAME_SITE=lax               # politique SameSite du cookie de session (durci au L04)
SESSION_HTTP_ONLY=true              # cookie inaccessible au script côté client

# --- En-têtes de sécurité (L04) ----------------------------------------------
CSP_REPORT_ONLY=true                # true : CSP en mode rapport (observation) ; false : bloquant

# --- Cache / Files / Diffusion / Fichiers (tout sur PostgreSQL) --------------
CACHE_STORE=database                # base de données : conforme au §3.1
# CACHE_PREFIX=
QUEUE_CONNECTION=database           # files d'attente en base : conforme au §3.1
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Messagerie (SMTP réel en production ; Mailpit en développement) ---------
MAIL_MAILER=smtp
MAIL_SCHEME=null                    # null | smtp | smtps
MAIL_HOST=127.0.0.1                 # `mailpit` en développement Docker ; hôte SMTP réel hors développement
MAIL_PORT=1025                      # 1025 pour Mailpit ; 587/465 pour un SMTP réel
MAIL_USERNAME=                      # SECRET — identifiant SMTP (hors développement)
MAIL_PASSWORD=                      # SECRET — mot de passe SMTP (hors développement)
MAIL_FROM_ADDRESS="hello@cesizen.local"
MAIL_FROM_NAME="${APP_NAME}"

# --- Assets front (Vite) -----------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

# =============================================================================
# Pilotes DÉLIBÉRÉMENT NON UTILISÉS (voir dossier §3.1)
# -----------------------------------------------------------------------------
# La configuration Laravel par défaut sait lire des variables pour d'autres
# pilotes (Redis, Memcached, magasins objets DynamoDB/SQS, Beanstalkd, canaux
# Slack/Papertrail, passerelles Postmark/Resend/SES). CESIZen ne les emploie
# PAS : sessions, cache et files restent sur PostgreSQL, la messagerie passe par
# SMTP. Ces variables sont donc volontairement absentes de ce fichier. Les
# ajouter suggérerait une infrastructure qui n'existe pas et contredirait le
# dossier. En cas de doute : ne pas ajouter.
# =============================================================================
